generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Severity {
  HIGH
  MEDIUM
  LOW
}

// The three kinds of rule in Section 3.6.6.
enum RuleKind {
  FIXED_CONDITION
  SAME_VALUE
  RELATIONSHIP
}

enum RunStatus {
  RUNNING
  CONSISTENT
  VIOLATIONS_FOUND
  FAILED
}

enum Representation {
  DECLARED
  LIVE
}

model Environment {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  gitDirectory String    @map("git_directory")
  k8sNamespace String    @map("k8s_namespace")
  findings     Finding[]

  @@map("environments")
}

model Rule {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  kind         RuleKind
  description  String?
  resource     String
  property     String
  environments String[]
  condition    String
  severity     Severity
  enabled      Boolean   @default(true)
  findings     Finding[]

  @@map("rules")
}

model ValidationRun {
  id                  Int       @id @default(autoincrement())
  startedAt           DateTime  @default(now()) @map("started_at")
  completedAt         DateTime? @map("completed_at")
  status              RunStatus @default(RUNNING)
  durationMs          Int?      @map("duration_ms")
  gitRef              String    @map("git_ref") // the configured ref, e.g. HEAD
  gitCommit           String?   @map("git_commit") // the commit SHA the manifests were read at
  kubeContext         String?   @map("kube_context") // null: the kubeconfig's current context
  // Counts stay null until that stage of the run has finished, so a FAILED run
  // shows how far it got.
  declaredRecordCount Int?      @map("declared_record_count")
  liveRecordCount     Int?      @map("live_record_count")
  rulesChecked        Int?      @map("rules_checked")
  findingCount        Int?      @map("finding_count")
  errorMessage        String?   @map("error_message")
  findings            Finding[]

  @@map("validation_runs")
}

model Finding {
  id             Int            @id @default(autoincrement())
  runId          Int            @map("run_id")
  environmentId  Int            @map("environment_id")
  ruleId         Int            @map("rule_id")
  resourceKind   String         @map("resource_kind")
  resourceName   String         @map("resource_name")
  property       String
  expected       String
  observed       String
  severity       Severity
  representation Representation

  run         ValidationRun @relation(fields: [runId], references: [id])
  environment Environment   @relation(fields: [environmentId], references: [id])
  rule        Rule          @relation(fields: [ruleId], references: [id])

  @@index([runId])
  @@map("findings")
}
