# Copy this file to .env and replace CHANGE_ME with a password.
# scripts/setup.ps1 does this automatically (with a random password) if .env does not exist.
# .env is ignored by Git: never commit it.
#
# The local PostgreSQL container (fyp-postgres) is created with the user, password,
# port and database named in this URL.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/fyp_config_platform?schema=public"
